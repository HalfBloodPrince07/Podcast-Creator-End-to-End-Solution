# LM Studio (local OpenAI-compatible server)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=local-model

# QWEN TTS — loaded locally via transformers (no API key needed)
# Set to a HuggingFace model ID or a local path
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign

# Optional: set HuggingFace cache directory (for model weights)
# TRANSFORMERS_CACHE=D:/models/huggingface

# Optional: output directory override
# OUTPUT_DIR=./outputs

# Optional: comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
